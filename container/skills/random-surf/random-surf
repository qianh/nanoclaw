def load_schedule():
    if os.path.exists(SCHEDULE_FILE):
        with open(SCHEDULE_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    return {}


def save_schedule(data):
    os.makedirs(os.path.dirname(SCHEDULE_FILE), exist_ok=True)
    with open(SCHEDULE_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)


def should_explore(schedule):
    next_run = schedule.get("next_run")
    if not next_run:
        return True
    return datetime.now() >= datetime.fromisoformat(next_run)


def main():
    schedule = load_schedule()

    if not should_explore(schedule):
        # 未到时间，静默退出
        return

    # 随机选择话题
    category, topics = random.choice(EXPLORATION_POOL)
    topic = random.choice(topics)

    # 计算下次时间（1-6小时随机）
    next_minutes = random.randint(60, 360)
    next_run = datetime.now() + timedelta(minutes=next_minutes)

    save_schedule({
        "next_run": next_run.isoformat(),
        "last_run": datetime.now().isoformat(),
        "last_topic": topic,
        "last_category": category,
        "interval_minutes": next_minutes,
    })

    # 输出探索信号（供 Claude 读取）
    print("EXPLORE_NOW")
    print(f"话题:{topic}")
    print(f"类型:{category}")
    print(f"下次探索:{next_run.strftime('%H:%M')}（{next_minutes}分钟后）")


if __name__ == "__main__":
    main()
